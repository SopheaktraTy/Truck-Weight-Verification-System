{
  "name": "🚨 Workflow 1 - Truck Critical Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "truck-alert",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson"
      },
      "id": "node-webhook",
      "name": "Supabase Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "truck-alert"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "cond-status",
              "leftValue": "={{ $json.record.status }}",
              "rightValue": "ត្រួតពិនិត្យ",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if",
      "name": "Is Inspect Status?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-field",
              "name": "message",
              "value": "=🚨 *ត្រួតពិនិត្យ — ទម្ងន់មិនត្រូវ!*\n\n🚛 *ឡាន:* `{{ $('Supabase Webhook').item.json.record.plate_number }}`\n📅 *ថ្ងៃ:* {{ $('Supabase Webhook').item.json.record.record_date }}\n👤 *អ្នកប្រតិបត្តិ:* {{ $('Supabase Webhook').item.json.record.operator_name }}\n\n⚖️ *ជញ្ជីង (NET):* {{ $('Supabase Webhook').item.json.record.scale_net_kg }} Kg\n📦 *ឃ្លាំង (Total):* {{ $('Supabase Webhook').item.json.record.warehouse_total_kg }} Kg\n📊 *ភាពខុសគ្នា:* {{ $('Supabase Webhook').item.json.record.diff_kg }} Kg ({{ $('Supabase Webhook').item.json.record.diff_percent }}%)\n\n⚠️ *សូមត្រួតពិនិត្យភ្លាមៗ!*",
              "type": "string"
            }
          ]
        }
      },
      "id": "node-format",
      "name": "Format Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 200]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {},
      "id": "node-noop",
      "name": "Approved — No Action",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 440]
    }
  ],
  "connections": {
    "Supabase Webhook": {
      "main": [
        [{ "node": "Is Inspect Status?", "type": "main", "index": 0 }]
      ]
    },
    "Is Inspect Status?": {
      "main": [
        [{ "node": "Format Alert Message", "type": "main", "index": 0 }],
        [{ "node": "Approved — No Action", "type": "main", "index": 0 }]
      ]
    },
    "Format Alert Message": {
      "main": [
        [{ "node": "Send Telegram Alert", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateId": "truck-alert-v1"
  },
  "tags": []
}
